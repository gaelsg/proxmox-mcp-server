# Los tokens reales de Proxmox/Portainer viven en Vault (secret/proxmox-mcp-server),
# no aqui. Este .env solo tiene el AppRole que sabe donde/como pedirlos - ver
# https://github.com/gaelsg/vault-secrets
VAULT_ADDR=https://192.168.8.91:8200
VAULT_CACERT=/home/gaelsg/projects/vault-secrets/tls/ca-cert.pem
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Fallback: si no defines lo de arriba, el servidor arranca con estas
# variables tal cual (ej. desarrollo local sin Vault). Con Vault configurado,
# estas se ignoran - los valores reales llegan de ahi en tiempo de ejecucion.
PROXMOX_HOST=192.168.8.75
PROXMOX_USER=mcp-agent@pve
PROXMOX_TOKEN_NAME=mcp-server-readonly
PROXMOX_TOKEN_VALUE=
PROXMOX_WRITE_TOKEN_NAME=mcp-agent-write
PROXMOX_WRITE_TOKEN_VALUE=
PROXMOX_VERIFY_SSL=false

PORTAINER_HOST=https://192.168.8.82:9443
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=3
PORTAINER_VERIFY_SSL=false
